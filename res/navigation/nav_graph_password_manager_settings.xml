<?xml version="1.0" encoding="utf-8"?>
<navigation android:id="@id/nav_graph_password_manager" app:startDestination="@id/passwordManagerSettingsFragment"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <include app:graph="@navigation/nav_graph_password_details" />
    <include app:graph="@navigation/nav_graph_enter_key_phrase" />
    <include app:graph="@navigation/nav_graph_password_create_key_phrase" />
    <fragment android:label="PasswordManagerSettingsFragment" android:name="com.alohamobile.passwordmanager.presentation.settings.PasswordManagerSettingsFragment" android:id="@id/passwordManagerSettingsFragment">
        <argument android:name="highlightViewId" android:defaultValue="-1" app:argType="integer" />
        <action android:id="@id/action_passwordManagerSettingsFragment_to_passwordsListFragment" app:destination="@id/passwordsListFragment" app:enterAnim="@anim/fragment_enter" app:exitAnim="@anim/fragment_exit" app:popEnterAnim="@anim/fragment_pop_enter" app:popExitAnim="@anim/fragment_pop_exit" />
        <action android:id="@id/action_passwordManagerSettingsFragment_to_neverSavePasswordListFragment" app:destination="@id/neverSavePasswordListFragment" app:enterAnim="@anim/fragment_enter" app:exitAnim="@anim/fragment_exit" app:popEnterAnim="@anim/fragment_pop_enter" app:popExitAnim="@anim/fragment_pop_exit" />
        <action android:id="@id/action_passwordManagerSettingsFragment_to_createKeyPhraseFragment" app:destination="@id/nav_graph_password_create_key_phrase" app:enterAnim="@anim/fragment_enter" app:exitAnim="@anim/fragment_exit" app:popEnterAnim="@anim/fragment_pop_enter" app:popExitAnim="@anim/fragment_pop_exit" />
        <action android:id="@id/action_passwordManagerSettingsFragment_to_nav_graph_enter_key_phrase" app:destination="@id/nav_graph_enter_key_phrase" app:enterAnim="@anim/fragment_enter" app:exitAnim="@anim/fragment_exit" app:popEnterAnim="@anim/fragment_pop_enter" app:popExitAnim="@anim/fragment_pop_exit" />
    </fragment>
    <fragment android:label="PasswordsListFragment" android:name="com.alohamobile.passwordmanager.presentation.list.PasswordsListFragment" android:id="@id/passwordsListFragment">
        <action android:id="@id/action_passwordsListFragment_to_passwordDetailsFragment" app:destination="@id/nav_graph_password_details" app:enterAnim="@anim/fragment_enter" app:exitAnim="@anim/fragment_exit" app:popEnterAnim="@anim/fragment_pop_enter" app:popExitAnim="@anim/fragment_pop_exit">
            <argument android:name="passwordUuid" app:argType="string" />
        </action>
    </fragment>
    <fragment android:label="NeverSavePasswordListFragment" android:name="com.alohamobile.passwordmanager.presentation.neversave.NeverSavePasswordListFragment" android:id="@id/neverSavePasswordListFragment" />
</navigation>
