<?xml version="1.0" encoding="utf-8"?>
<navigation android:id="@id/nav_graph_profile_login" app:startDestination="@id/loginFragment"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <include app:graph="@navigation/nav_graph_enter_2fa_code" />
    <argument android:name="isTokenExpired" app:argType="boolean" />
    <argument android:name="successfulLoginAction" android:defaultValue="OPEN_PROFILE_SETTINGS" app:argType="com.alohamobile.profile.core.data.auth.SuccessfulLoginAction" />
    <fragment android:label="LoginFragment" android:name="com.alohamobile.profile.auth.presentation.fragment.LoginFragment" android:id="@id/loginFragment" app:enterAnim="@anim/fragment_enter" app:exitAnim="@anim/fragment_exit" app:popEnterAnim="@anim/fragment_pop_enter" app:popExitAnim="@anim/fragment_pop_exit">
        <argument android:name="showPasswordRecoveryLinkSentDialog" android:defaultValue="false" app:argType="boolean" />
        <argument android:name="isTokenExpired" android:defaultValue="false" app:argType="boolean" />
        <argument android:name="passwordRecoveryEmail" android:defaultValue="@null" app:argType="string" app:nullable="true" />
        <argument android:name="successfulLoginAction" android:defaultValue="OPEN_PROFILE_SETTINGS" app:argType="com.alohamobile.profile.core.data.auth.SuccessfulLoginAction" />
        <action android:id="@id/action_loginFragment_to_profilePasswordRecoveryFragment" app:destination="@id/profilePasswordRecoveryFragment" app:enterAnim="@anim/fragment_enter" app:exitAnim="@anim/fragment_exit" app:popEnterAnim="@anim/fragment_pop_enter" app:popExitAnim="@anim/fragment_pop_exit" />
        <action android:id="@id/action_loginFragment_to_OAuthEmailRequestFragment" app:destination="@id/OAuthEmailRequestFragment" app:enterAnim="@anim/fragment_enter" app:exitAnim="@anim/fragment_exit" app:popEnterAnim="@anim/fragment_pop_enter" app:popExitAnim="@anim/fragment_pop_exit" />
