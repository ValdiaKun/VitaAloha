<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/corner_m" />
            <stroke android:width="1.0dp" android:color="?fillColorQuinary" />
            <solid android:color="?fillColorSenary" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/corner_m" />
            <stroke android:width="1.0dp" android:color="?fillColorBrandPrimary" />
            <solid android:color="?layerColorFloor1" />
        </shape>
    </item>
    <item android:state_enabled="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/corner_m" />
            <stroke android:width="1.0dp" android:color="?fillColorQuaternary" />
            <solid android:color="?layerColorFloor1" />
        </shape>
    </item>
</selector>
