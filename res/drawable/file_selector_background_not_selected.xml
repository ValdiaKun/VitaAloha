<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?fillColorBrandQuaternary" />
            <corners android:radius="@dimen/corner_l" />
            <stroke android:width="1.0dp" android:color="?fillColorBrandSecondary" android:dashWidth="8.0dp" android:dashGap="8.0dp" />
        </shape>
    </item>
    <item>
        <ripple android:color="?rippleColorBrandSecondary">
            <item android:id="@android:id/mask">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/corner_l" />
                    <solid android:color="#fff" />
                </shape>
            </item>
        </ripple>
    </item>
</layer-list>
