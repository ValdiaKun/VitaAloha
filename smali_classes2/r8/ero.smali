.class public final Lr8/ero;
.super Lr8/dro;


# direct methods
.method public constructor <init>()V
    .locals 0

    invoke-direct {p0}, Lr8/dro;-><init>()V

    return-void
.end method

.method public constructor <init>(Lr8/sro;)V
    .locals 0

    invoke-direct {p0, p1}, Lr8/dro;-><init>(Lr8/sro;)V

    return-void
.end method
