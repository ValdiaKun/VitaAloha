.class public Lr8/lro;
.super Lr8/kro;


# direct methods
.method public constructor <init>(Lr8/sro;Landroid/view/WindowInsets;)V
    .locals 0

    invoke-direct {p0, p1, p2}, Lr8/kro;-><init>(Lr8/sro;Landroid/view/WindowInsets;)V

    return-void
.end method

.method public constructor <init>(Lr8/sro;Lr8/lro;)V
    .locals 0

    invoke-direct {p0, p1, p2}, Lr8/kro;-><init>(Lr8/sro;Lr8/kro;)V

    return-void
.end method
