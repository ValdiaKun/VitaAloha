.class public Lr8/bro;
.super Lr8/aro;


# direct methods
.method public constructor <init>()V
    .locals 0

    invoke-direct {p0}, Lr8/aro;-><init>()V

    return-void
.end method

.method public constructor <init>(Lr8/sro;)V
    .locals 0

    invoke-direct {p0, p1}, Lr8/aro;-><init>(Lr8/sro;)V

    return-void
.end method
